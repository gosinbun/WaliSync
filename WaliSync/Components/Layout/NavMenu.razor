@inject NavigationManager NavigationManager
@inject ToastService ToastService

<!-- Desktop Sidebar -->
<aside class="app-sidebar">
    <div>
        <!-- Brand Header -->
        <div class="d-flex align-items-center gap-2 mb-4 pb-2">
            <div class="d-flex align-items-center justify-content-center bg-accent text-primary-ink fw-bold"
                 style="width: 38px; height: 38px; border-radius: 10px; font-size: 1.15rem;">
                <i class="fa-solid fa-graduation-cap"></i>
            </div>
            <span class="fs-5 fw-bold text-white tracking-wide">WaliSync</span>
        </div>

        <!-- Navigation Links -->
        <nav class="d-flex flex-column gap-1">
            <NavLink class="nav-pill-custom" href="" Match="NavLinkMatch.All">
                <i class="fa-solid fa-border-all" style="width: 20px;"></i>
                <span>Dashboard</span>
            </NavLink>
            <NavLink class="nav-pill-custom" href="dosen">
                <i class="fa-solid fa-chalkboard-user" style="width: 20px;"></i>
                <span>Data Dosen</span>
            </NavLink>
            <NavLink class="nav-pill-custom" href="mahasiswa">
                <i class="fa-solid fa-user-graduate" style="width: 20px;"></i>
                <span>Data Mahasiswa</span>
            </NavLink>
        </nav>
    </div>

    <!-- Bottom Action: Log Out Simulation -->
    <div>
        <button type="button" class="btn w-100 d-flex align-items-center justify-content-center gap-2 py-2 px-3 text-white border-0"
                style="background-color: rgba(255, 255, 255, 0.06); border-radius: 12px; font-size: 0.875rem;"
                @onclick="HandleLogout">
            <i class="fa-solid fa-arrow-right-from-bracket text-danger-custom"></i>
            <span>Log Out</span>
        </button>
    </div>
</aside>

<!-- Mobile Bottom Navigation Bar (< 768px) -->
<nav class="mobile-bottom-nav">
    <NavLink class="mobile-nav-item" href="" Match="NavLinkMatch.All">
        <i class="fa-solid fa-border-all fs-5"></i>
        <span>Home</span>
    </NavLink>
    <NavLink class="mobile-nav-item" href="dosen">
        <i class="fa-solid fa-chalkboard-user fs-5"></i>
        <span>Dosen</span>
    </NavLink>
    <NavLink class="mobile-nav-item" href="mahasiswa">
        <i class="fa-solid fa-user-graduate fs-5"></i>
        <span>Mahasiswa</span>
    </NavLink>
    <a href="javascript:void(0)" class="mobile-nav-item" @onclick="HandleLogout">
        <i class="fa-solid fa-arrow-right-from-bracket fs-5 text-danger-custom"></i>
        <span>Keluar</span>
    </a>
</nav>

@code {
    private void HandleLogout()
    {
        ToastService.ShowSuccess("Simulasi Log Out berhasil. Akses sistem tetap terbuka.");
        NavigationManager.NavigateTo("/");
    }
}

