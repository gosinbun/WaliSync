# WaliSync Environment Configuration Example
# Salin berkas ini ke .env atau sesuaikan pada appsettings.json

# Konfigurasi Database SQLite
ConnectionStrings__DefaultConnection=Data Source=AcademicDb.db

# Konfigurasi Port API ASP.NET Core
ASPNETCORE_URLS=http://localhost:5000;http://*:5000
ASPNETCORE_ENVIRONMENT=Development

